# Contact delivery uses the Amplify SSR Compute IAM role with Amazon SES and
# DynamoDB. No long-lived AWS key belongs in this file.
FORTRESS_AWS_REGION=us-east-1
CONTACT_OPERATIONS_TABLE=fortress-contact-operations-prod
CONTACT_TO_EMAIL=clientservices@fortresstaxadvisors.com
CONTACT_FROM_EMAIL=Fortress Tax Advisors <clientservices@fortresstaxadvisors.com>
CONTACT_REPLY_EMAIL=clientservices@fortresstaxadvisors.com

# Opt in to real AWS delivery during local development. Production enables it
# automatically and receives temporary credentials from the Compute role.
CONTACT_ENABLE_AWS_DELIVERY=false

# Optional Cloudflare Turnstile defense-in-depth. Durable DynamoDB limits and
# the honeypot remain active when this is disabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=fortresstaxadvisors.com,www.fortresstaxadvisors.com

# Optional: enforce Turnstile in a non-production environment.
CONTACT_REQUIRE_TURNSTILE=false
