# Amplify branch configuration. The build script copies only this reviewed,
# non-secret allowlist into .env.production for the SSR runtime.
FORTRESS_DEPLOYMENT_STAGE=sandbox
FORTRESS_RUNTIME_SECRET_ID=fortress/website/billing-sandbox
FORTRESS_AWS_REGION=us-east-1
FORTRESS_SECRET_CACHE_TTL_SECONDS=300
PAYMENT_BASE_URL=https://sandbox.fortresstaxadvisors.com
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
# Square Sandbox accepts only 1 KB total invoice attachments. Set true only
# for workflow testing; production never skips the completed agreement.
SQUARE_SANDBOX_SKIP_ATTACHMENTS=true
# Allows staff to enable Square ACH on an individual engagement. Each new
# engagement still defaults ACH off and requires an explicit staff checkbox.
SQUARE_ENABLE_ACH=true
SQUARE_WEBHOOK_NOTIFICATION_URL=https://sandbox.fortresstaxadvisors.com/api/webhooks/square
# Private operational ledger and versioned evidence archive.
FORTRESS_BILLING_OPERATIONS_TABLE=
FORTRESS_BILLING_EVIDENCE_BUCKET=
# Exact SNS topic ARN used for urgent dispute alerts. Recipient email addresses
# are configured only by the deployment operator and are not runtime variables.
FORTRESS_DISPUTE_ALERT_TOPIC_ARN=
# Optional Zapier, Make, Slack relay, CRM, or internal automation endpoint.
PAYMENT_EVENT_FORWARD_URL=

# Self-hosted DocuSeal contract/signature gate.
DOCUSEAL_BASE_URL=https://sign.fortresstaxadvisors.com/api
DOCUSEAL_ENGAGEMENT_TEMPLATE_ID=
DOCUSEAL_SERVICE_ACCEPTANCE_TEMPLATE_ID=
DOCUSEAL_CLIENT_ROLE=Client
DOCUSEAL_FIRM_ROLE=Fortress
DOCUSEAL_FIRM_SIGNER_NAME=
DOCUSEAL_FIRM_SIGNER_EMAIL=
DOCUSEAL_COMPLETED_BCC=
DOCUSEAL_REPLY_TO=clientservice@fortresstaxadvisors.com
# Human end-to-end Sandbox testing: deliver real DocuSeal invitations while
# Square remains isolated in its Sandbox and cannot charge a live card.
DOCUSEAL_SANDBOX_SEND_EMAIL=true

# Square does not send email in its Sandbox. This Fortress-owned test notice
# delivers the published Sandbox invoice URL without enabling live charges.
FORTRESS_SANDBOX_INVOICE_EMAIL=true
FORTRESS_TRANSACTIONAL_EMAIL_FROM=engagements@fortresstaxadvisors.com
FORTRESS_TRANSACTIONAL_EMAIL_REPLY_TO=clientservice@fortresstaxadvisors.com

# Production secrets are one JSON SecretString matching
# config/runtime-secret.example.json. Do not add those keys to Amplify branch
# environment variables. For local development only, copy both templates into
# an ignored .env.local, set FORTRESS_ALLOW_LOCAL_ENV_SECRETS=true, and add the
# secret JSON keys as environment variables.

# Operator workstation only; never an Amplify runtime variable:
# SQUARE_DEVELOPER_ACCESS_TOKEN=
